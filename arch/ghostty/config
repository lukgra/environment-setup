# Theme
# theme = Catppuccin Mocha
theme = Gruvbox Dark

# Font configuration
font-family = "Hack Nerd Font Mono"
font-style = Regular
font-size = 13

# Window settings
window-padding-x = 14
window-padding-y = 14
window-decoration = true
macos-titlebar-style = hidden
background-opacity = 0.90
background-blur = 20

# Shaders
custom-shader = ~/.config/ghostty/shaders-repo/cursor_blaze.glsl
custom-shader-animation = true
