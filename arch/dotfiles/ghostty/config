# Shell
shell-integration = zsh
command = /usr/bin/zsh

# Theme
theme = Catppuccin Mocha

# Font configuration
font-family = "Hack Nerd Font Mono"
font-style = Regular
font-size = 12

# Window settings
window-padding-x = 14
window-padding-y = 14
window-decoration = true
macos-titlebar-style = hidden
background-opacity = 0.96
background-blur-radius = 20

