/* My Mostly Used waybar config incase you wonder :) */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    ],
  "layer": "bottom",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 3,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 2,
  "margin-left": 0,
  "margin-right": 5,

  "modules-left": [
    "custom/power",
    "custom/separator#dot-blank",	
    "hyprland/workspaces#numbers",
  ],

  "modules-center": [
    "hyprland/window",
  ],

  "modules-right": [
    "tray",
    "custom/separator#blank",
    "group/notify",
    "network",
    "custom/separator#blank",  
    "group/audio",
    "custom/separator#blank",  
    "group/battery-management",
    "custom/separator#blank",
    "clock",
  ],
}

