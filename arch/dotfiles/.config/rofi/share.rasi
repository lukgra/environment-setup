@import "colors.rasi"

* {
  border: 1;
  margin: 0;
  padding: 0;
  spacing: 0;

  urgent:           @rofi-urgent;
  active:           @rofi-active;
  bg:               @rofi-bg;
  bg-alt:           @rofi-bg-alt;
  fg:               @rofi-fg;
  fg-alt:           @rofi-fg-alt;
  selected:         @rofi-fg-alt;
  background-color: @rofi-bg;
  text-color:       @rofi-fg;
}
configuration {
  font: "JetBrains Mono Nerd Font 12";
  terminal: "alacritty";

  combi {
    display-name: "󰍜";
  }

  drun {
    display-name: "󱓞";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  microphone {
    display-name: "󰍬";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }

  filebrowser {
    display-name: "";
  }

  display-drun: "Application:";
  display-window: "Window:";
  display-filebrowser: "Files:";
  case-sensitive: false;
  sort: true;
  sorting-method: "fzf";
  modi: [
    "run",
    "drun",
    "window",
    "filebrowser"
  ];
  show-icons: true;
  terminal: "ghostty";
}

window {
    /* properties for window widget */
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    font:                        "JetBrains Mono Nerd Font 12";
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    cursor:                      "default";
    background-color:            @bg;
}
